{
  "name": "videorandom",
  "version": "1.9.2",
  "description": "Video Roulette - Premium Random Video Picker for Windows",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build": "pkg . --targets node18-win-x64 --compress GZip --output videorandom.exe",
    "postbuild": "node scripts/write_update_manifest.js"
  },
  "pkg": {
    "scripts": [
      "node_modules/generator-function/*.js",
      "node_modules/async-function/*.js"
    ],
    "assets": [
      "public/**/*",
      "scripts/transcribe_local.py",
      "scripts/recover_recent.ps1",
      "scripts/apply_update.ps1",
      "scripts/launch_update.ps1",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe"
    ]
  },
  "keywords": [],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "form-data": "^4.0.6",
    "multer": "^2.4.0",
    "open": "^8.4.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
